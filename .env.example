# Emdexer environment configuration example.
# Copy to .env and fill in the values.

# ── Embedding providers ───────────────────────────────────────────────────────
GOOGLE_API_KEY=
EMDEX_GEMINI_MODEL=gemini-embedding-2-preview
# EMBED_PROVIDER=gemini  # gemini (default) | ollama | openai
# OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=text-embedding-3-small
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_EMBED_MODEL=nomic-embed-text:v2

# ── Auth ─────────────────────────────────────────────────────────────────────
EMDEX_AUTH_KEY=

# ── Gateway ──────────────────────────────────────────────────────────────────
# EMDEX_PORT=7700
# EMDEX_QDRANT_COLLECTION=emdexer_v1

# ── Prometheus file_sd service discovery ─────────────────────────────────────
# EMDEX_SD_FILE=/etc/prometheus/targets/emdexer_nodes.json

# Host IP to use in Prometheus file_sd targets instead of Docker container hostnames.
# Set to the Docker host IP when Prometheus runs outside Docker.
EMDEX_SD_HOST_OVERRIDE=

# ── Node URL (for external Prometheus scraping) ───────────────────────────────
# Full URL this node advertises to the gateway. Set to the host-mapped address
# when Prometheus runs outside Docker. Default matches port mapping 8083:8081.
# EMDEX_NODE_URL_NODE=http://<host-ip>:8083

# ── Gateway query cache (P47) ────────────────────────────────────────────────
# Defaults to Redis-backed in docker-compose.yml. Set to false to disable.
EMDEX_CACHE_ENABLED=true
EMDEX_CACHE_BACKEND=redis
EMDEX_CACHE_REDIS_URL=redis://redis:6379
EMDEX_CACHE_TTL=5m
EMDEX_CACHE_MAX_ENTRIES=1000

# ── Node delta-indexing cache (Phase 15.6 / P47) ─────────────────────────
# SQLite file-cache (path → xxh3 hash) used to skip re-indexing unchanged
# files. MUST be a persistent volume in production — losing it forces full
# re-extraction of every file on next poll cycle.
# This path must match the volume mount in deploy/docker/docker-compose.yml.
EMDEX_CACHE_DIR=/app/cache
# Days before a file's row is purged from the cache after it stops being seen
# (e.g. file deleted from source). Range: 1-3650. Default: 30.
EMDEX_CACHE_RETENTION_DAYS=30
# Hours between SQLite VACUUM cycles. 0 disables. Default: 24.
EMDEX_CACHE_VACUUM_INTERVAL_HOURS=24

# ── Webhook (Phase 44) ───────────────────────────────────────────────────────
# Called with POST + JSON payload after each namespace finishes indexing.
# Empty = disabled. SSRF-safe: requests to private/loopback IPs are blocked.
# Payload: {"event":"namespace.indexed","namespace":"...","node_id":"...",
#           "files_indexed":N,"timestamp":"2026-..."}
EMDEX_WEBHOOK_URL=

# ── P50: Cross-node extraction-result cache (Redis) ──────────────────────
# OFF by default — extracted text may be sensitive. Enable only when the
# operational tradeoff is understood.
EMDEX_EXTRACT_CACHE_ENABLED=false
EMDEX_EXTRACT_CACHE_REDIS_URL=redis://redis:6379
# 30 days. Lower if extracted text is sensitive.
EMDEX_EXTRACT_CACHE_TTL=720h

# ── RAGAS eval sidecar (opt-in: docker compose --profile eval up ragas-sidecar)
EMDEX_RAGAS_URL=http://localhost:8006
RAGAS_LLM_PROVIDER=openai
RAGAS_MODEL=gpt-4o-mini
RAGAS_PORT=8006
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
